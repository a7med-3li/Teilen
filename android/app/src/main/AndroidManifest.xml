<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teilen">

        <!-- manual path: open the app, paste, send -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- everything this account has shared, read back on the phone -->
        <activity
            android:name=".FeedActivity"
            android:exported="false"
            android:label="@string/feed_title" />

        <!-- one shared image, full screen; the tap target that closes it is the whole screen -->
        <activity
            android:name=".ImageViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Teilen.Share" />

        <!--
            the far end of pairing: a browser draws a QR holding teilen://pair?code=…, the phone's
            own camera opens that link, and this is what it lands on. No camera permission and no
            QR library needed — the scanning is the camera app's job.
        -->
        <activity
            android:name=".PairActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.Teilen.Share">

            <intent-filter android:priority="10">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="teilen" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- zero-friction path: this is what shows up in the system share sheet, for any content type -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Teilen.Share">

            <!-- single item: text, links, images, PDFs, anything at all -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.teilen.app.category.DIRECT_SHARE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- multi-select from galleries, file managers, mail attachments -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.teilen.app.category.DIRECT_SHARE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- pins Teilen to the top row of the share sheet (see res/xml/shortcuts.xml) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            the actual upload, kept alive without a window so a big file finishes even after the
            share sheet is gone; starts the moment a share is dispatched and posts its progress
            to the notification shade.
        -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- "Copy to Teilen" in the selection toolbar of every app on the phone -->
        <activity
            android:name=".ProcessTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/process_text_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Teilen.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- "Send" on the notification that appears after you copy something -->
        <activity
            android:name=".SendClipboardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Teilen.Invisible" />

        <!-- watches the clipboard so a copy can be offered to Teilen; it never sends by itself -->
        <service
            android:name=".ClipboardWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Offers a one-tap action to send text the user just copied to their own server" />
        </service>
    </application>
</manifest>
