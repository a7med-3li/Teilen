<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pair_modal_title"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/dialog_pair_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/pair_modal_subtitle" />

    <!-- Section 1: This Device's Code -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_your_code_label"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/dialog_pair_spinner"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dialog_pair_code"
                style="@style/Text.Tabular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="····-····"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textDirection="ltr" />

            <Button
                android:id="@+id/dialog_btn_copy_code"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:minHeight="32dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_copy"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/dialog_btn_refresh_code"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Code"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sync"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialog_pair_status"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pair_your_code_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider -->
    <TextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/pair_enter_code_label"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Section 2: Enter Code from Another Device (8-Box Auto-Advancing OTP) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="ltr">

            <!-- First 4 Boxes -->
            <EditText
                android:id="@+id/otp_box_1"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_2"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_3"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_4"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <!-- Static Dash Separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="—"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Second 4 Boxes -->
            <EditText
                android:id="@+id/otp_box_5"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_6"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_7"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/otp_box_8"
                style="@style/Input.Field"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:fontFamily="monospace" />

            <!-- Paste Button Pill -->
            <Button
                android:id="@+id/btn_pair_paste"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_paste"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Connect Button -->
        <Button
            android:id="@+id/btn_submit_manual_code"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:minHeight="42dp"
            android:text="@string/btn_connect_device"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_manual_pair"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="14dp"
        android:background="@color/divider" />

    <!-- Section 3: Connected Devices -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_devices_title"
                style="@style/Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONNECTED DEVICES (1)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/dialog_btn_disconnect_others"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minHeight="28dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_disconnect_all"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dialog_devices_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
