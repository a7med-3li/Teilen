<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Header: Back Button, Progress Dots, Skip Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/onboarding_btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pair_cancel"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/onboarding_dots_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/onboarding_dot_1"
                    android:layout_width="24dp"
                    android:layout_height="6dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_segmented_selected" />

                <View
                    android:id="@+id/onboarding_dot_2"
                    android:layout_width="8dp"
                    android:layout_height="6dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_button_outline" />

                <View
                    android:id="@+id/onboarding_dot_3"
                    android:layout_width="8dp"
                    android:layout_height="6dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_button_outline" />
            </LinearLayout>

            <Button
                android:id="@+id/onboarding_btn_skip"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/onboarding_skip"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Slide Frame Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- SLIDE 1: Instant Zero-Knowledge Sharing -->
            <ScrollView
                android:id="@+id/onboarding_slide_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <!-- Vector Illustration: Phone <~ Encrypted Beam ~> Laptop -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Phone -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_tab_send"
                                    android:tint="@color/accent" />

                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Phone"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Connecting Beam Line with Lock & Countdown ring -->
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="2.5dp"
                                    android:layout_gravity="center"
                                    android:background="@color/electric_sky" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_badge"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingStart="8dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:src="@drawable/ic_lock"
                                        android:tint="@color/accent" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="monospace"
                                        android:text="E2EE"
                                        android:textColor="@color/accent"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </FrameLayout>

                            <!-- Laptop -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_tab_feed"
                                    android:tint="@color/accent" />

                                <TextView
                                    style="@style/Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Computer"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Micro Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_onboarding_badge"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="@string/onboarding_slide1_badge"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Headline -->
                    <TextView
                        style="@style/Text.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/onboarding_slide1_title"
                        android:textSize="22sp" />

                    <!-- Body -->
                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/onboarding_slide1_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </ScrollView>

            <!-- SLIDE 2: Open Teilen on Your Computer -->
            <ScrollView
                android:id="@+id/onboarding_slide_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <!-- Glowing Browser Address Bar Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glowing_address_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/onboarding_web_url"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="https://teilen.app"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/onboarding_btn_copy_url"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_scanner_btn"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_copy_url"
                            android:textColor="@color/electric_sky"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Headline -->
                    <TextView
                        style="@style/Text.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/onboarding_slide2_title"
                        android:textSize="22sp" />

                    <!-- Subtitle / Body -->
                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/onboarding_slide2_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Action Buttons for Live Pairing during Onboarding -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/onboarding_btn_enter_code"
                            style="@style/Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:drawableStart="@drawable/ic_paste"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/on_accent"
                            android:text="@string/onboarding_slide2_enter_code" />

                        <Button
                            android:id="@+id/onboarding_btn_share_link"
                            style="@style/Button.Outline"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/btn_share_link" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- SLIDE 3: Share From Anywhere in 1 Tap -->
            <ScrollView
                android:id="@+id/onboarding_slide_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <!-- OS Integrations Diagram -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Item 1: System Share Sheet -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_segmented_selected"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/accent"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Android System Share Sheet"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Item 2: Text Selection Menu -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_segmented_selected"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="@color/accent"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Select Text → &quot;Copy to Teilen&quot;"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Item 3: 1-Tap Notification -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_segmented_selected"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="@color/accent"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="1-Tap Instant Clipboard Sync"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Headline -->
                    <TextView
                        style="@style/Text.Header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/onboarding_slide3_title"
                        android:textSize="22sp" />

                    <!-- Body -->
                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/onboarding_slide3_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Optional Quick Toggle for Clipboard Watcher -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/onboarding_slide3_toggle_clip"
                            android:textSize="13sp" />

                        <Switch
                            android:id="@+id/onboarding_switch_clipboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Bottom Action Button: Next / Enter Vault -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/onboarding_btn_next"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/onboarding_next" />

            <Button
                android:id="@+id/onboarding_btn_enter"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/electric_sky"
                android:text="@string/onboarding_slide3_cta"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
