<?xml version="1.0" encoding="utf-8"?>
<!--
    One image, as large as the screen. Black rather than the app's paper, because a photo is
    usually its own background and a light frame shows the phone's bezels as part of the picture.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/image_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/feed_thumb"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/image_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:ellipsize="middle"
        android:padding="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/image_failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:text="@string/image_failed"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>