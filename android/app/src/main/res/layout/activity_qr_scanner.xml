<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian">

    <!-- Camera Preview and ZXing Finder -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_use_texture_view="true" />

    <!-- Overlay UI Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/scanner_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/scanner_btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_scanner_btn"
                android:contentDescription="@string/pair_cancel"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/scanner_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Prompt Text Pill positioned above bottom button -->
        <LinearLayout
            android:id="@+id/scanner_prompt_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/scanner_bottom_container"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/scanner_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_scanner_pill"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/scanner_prompt_text"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:id="@+id/scanner_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/scanner_btn_manual_code"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_scanner_cta"
                android:text="@string/scanner_enter_manual_code"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
