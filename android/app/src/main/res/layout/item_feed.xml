<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Sticky Header Bar: Left: Type & Meta; Right: All Action Buttons -->
    <LinearLayout
        android:id="@+id/feed_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Badge & Meta -->
        <TextView
            android:id="@+id/feed_kind"
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/feed_meta"
            style="@style/Text.Tabular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Right: Action Buttons Toolbar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Countdown Ring -->
            <com.teilen.app.CountdownRingView
                android:id="@+id/feed_ring"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp" />

            <!-- +1h / Edit TTL Button -->
            <Button
                android:id="@+id/feed_action_extend"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="+1h"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Copy Button -->
            <Button
                android:id="@+id/feed_action_copy"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Copy"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <!-- Download Button -->
            <Button
                android:id="@+id/feed_action_download"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="2dp"
                android:drawableTint="@color/accent"
                android:text="DL"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Open Button (for links) -->
            <Button
                android:id="@+id/feed_action_open"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Open"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Code / Monospace Toggle Button -->
            <Button
                android:id="@+id/feed_action_code"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="&lt;&gt;"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Expand / Full View Toggle Button -->
            <Button
                android:id="@+id/feed_action_expand"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:minHeight="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Full"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Delete Button -->
            <Button
                android:id="@+id/feed_action_delete"
                style="@style/Button.Outline"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:minWidth="28dp"
                android:minHeight="26dp"
                android:padding="4dp"
                android:drawableStart="@drawable/ic_trash"
                android:drawableTint="@color/danger"
                android:contentDescription="@string/delete_item" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card Body: Image preview and/or scrollable text content -->
    <LinearLayout
        android:id="@+id/feed_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/feed_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_input"
            android:contentDescription="@string/feed_thumb"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/feed_title"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.18"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
