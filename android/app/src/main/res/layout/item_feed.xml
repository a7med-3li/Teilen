<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Sticky Header Bar: Left: Type & Meta; Right: Compact Action Buttons -->
    <LinearLayout
        android:id="@+id/feed_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Badge, Countdown Ring, & Meta -->
        <TextView
            android:id="@+id/feed_kind"
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Countdown Ring -->
        <com.teilen.app.CountdownRingView
            android:id="@+id/feed_ring"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/feed_meta"
            style="@style/Text.Tabular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Right: Compact Action Buttons Toolbar (Strictly non-overflowing) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Primary 1: Copy Button (Text, Link, Image) -->
            <Button
                android:id="@+id/feed_action_copy"
                style="@style/Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="30dp"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:drawableStart="@drawable/ic_copy"
                android:drawablePadding="4dp"
                android:drawableTint="@color/accent"
                android:text="Copy"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <!-- Primary 2: Download Button (Image, File, PDF, Audio) -->
            <ImageButton
                android:id="@+id/feed_action_download"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_icon_btn"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                android:tint="@color/accent"
                android:contentDescription="Download"
                android:visibility="gone" />

            <!-- Quick Actions Overflow Menu Button (⋮) -->
            <ImageButton
                android:id="@+id/feed_action_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_btn"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/text_secondary"
                android:contentDescription="More options" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card Body: Image preview and/or selectable text content -->
    <LinearLayout
        android:id="@+id/feed_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/feed_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_input"
            android:contentDescription="@string/feed_thumb"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/feed_title"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.18"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:autoLink="web"
            android:linksClickable="true" />
    </LinearLayout>

</LinearLayout>
