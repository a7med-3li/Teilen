<?xml version="1.0" encoding="utf-8"?>
<!--
    The dark half of the palette, same names. Applied automatically by the platform when the
    system is in night mode. Note: the -night qualifier needs API 29; on Android 8 and 9 the
    app simply stays in its light theme.
-->
<resources>
    <!-- surfaces -->
    <color name="bg">#0D1117</color>
    <color name="surface">#161C24</color>
    <color name="surface_alt">#1F2731</color>

    <!-- ink -->
    <color name="text_primary">#E7ECF2</color>
    <color name="text_secondary">#97A3B2</color>
    <color name="divider">#2A333F</color>

    <color name="accent">#2DD4BF</color>
    <color name="accent_text">#5EEAD4</color>
    <color name="on_accent">#052B27</color>
    <color name="brand_bar">#0B3B37</color>
    <color name="on_brand_dim">#9FD6D0</color>

    <color name="danger">#FF8A80</color>
    <color name="ripple">#33FFFFFF</color>
    <color name="ripple_soft">#332DD4BF</color>
</resources>